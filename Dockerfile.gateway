# Blind WSS rendezvous gateway for Lerdr.
#
# Build:  docker build -f Dockerfile.gateway -t lerdr-gateway .
# Run:    docker run -p 8443:8443 -e LERDR_GATEWAY_ADDR=:8443 lerdr-gateway
#
# The image contains a single static binary and no shell. Put TLS in front of it
# (see docs/gateway-self-hosting.md); the gateway itself speaks plain HTTP so a
# reverse proxy owns certificates.

FROM golang:1.27.0-alpine AS build

WORKDIR /src

# Dependencies first so a source-only change reuses the module layer.
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/lerdr-gateway ./cmd/lerdr-gateway
COPY internal/gateway ./internal/gateway
COPY internal/gatewaywire ./internal/gatewaywire

ARG LERDR_GATEWAY_VERSION=dev
ARG LERDR_GATEWAY_REVISION=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X main.version=${LERDR_GATEWAY_VERSION} -X main.revision=${LERDR_GATEWAY_REVISION}" \
    -o /out/lerdr-gateway ./cmd/lerdr-gateway

FROM gcr.io/distroless/static:nonroot

COPY --from=build /out/lerdr-gateway /usr/local/bin/lerdr-gateway

USER nonroot:nonroot
EXPOSE 8443
# Address discovery is raw STUN on UDP, so it cannot go through the TLS reverse
# proxy in front of 8443: publish this port straight to the host. Set
# LERDR_GATEWAY_STUN_ADDR= (empty) to turn the listener off instead.
EXPOSE 3478/udp

# LERDR_GATEWAY_STATE is unset by default: counters live in memory only. Mount a
# writable volume and point it there to keep quotas across restarts.
ENV LERDR_GATEWAY_ADDR=:8443 \
    LERDR_GATEWAY_LOG_FORMAT=json

ENTRYPOINT ["/usr/local/bin/lerdr-gateway"]
