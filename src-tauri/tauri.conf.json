{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lerdr",
  "version": "0.26.2",
  "identifier": "com.github.igunublue.lerdr",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../frontend" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lerdr",
        "fullscreen": false,
        "resizable": true,
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: http: ws:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-192.png",
      "icons/icon-512.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
